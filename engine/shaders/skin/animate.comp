// Palette walk ported from UNIVR_CGPROJ shaders/animate.comp.
// Parent == self is the root. palette = global * inverse_bind.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Bone {
    mat4 local;
    mat4 inverse_bind;
    uint parent;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

layout(set = 0, binding = 0, std430) readonly buffer Bones {
    Bone bones[];
} bones;

layout(set = 0, binding = 1, std430) writeonly buffer Palette {
    mat4 offset[];
} palette;

void main() {
    uint bone_index = gl_GlobalInvocationID.x;
    if (bone_index >= uint(bones.bones.length())) {
        return;
    }
    uint current = bone_index;
    mat4 global = mat4(1.0);
    for (uint hop = 0u; hop < 64u; ++hop) {
        global = bones.bones[current].local * global;
        uint parent = bones.bones[current].parent;
        if (parent == current) {
            break;
        }
        current = parent;
    }
    palette.offset[bone_index] = global * bones.bones[bone_index].inverse_bind;
}

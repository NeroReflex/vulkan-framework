// Copies per-frame skinning matrices into the palette buffer used by deform / surfel_world.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer PerFrameSkeletonBuffer {
    mat4 offset_matrix[];
} per_frame_skeleton;

layout(set = 0, binding = 1, std430) writeonly buffer Palette {
    mat4 bone[];
} palette;

void main() {
    uint bone_index = gl_GlobalInvocationID.x;
    if (bone_index >= uint(per_frame_skeleton.offset_matrix.length())) {
        return;
    }
    if (bone_index >= uint(palette.bone.length())) {
        return;
    }
    palette.bone[bone_index] = per_frame_skeleton.offset_matrix[bone_index];
}

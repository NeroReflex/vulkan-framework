// For every surfel alive last frame: follow its instance, evict it or keep it.
// Survivors are appended to this frame's alive list; evicted slots are pushed
// on the free stack. This is the only pass that frees slots.
#include "compute.glsl"

layout(local_size_x = 256) in;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= uint(state[ST_ALIVE_IN])) {
        return;
    }
    const uint id = alive_ids[alive_in_base() + i];
    const uint flags = surfels[id].flags;
    const uint inst = surfels[id].instance_id;

    bool keep = (flags & SURFEL_FLAG_ALIVE) != 0u && (flags & SURFEL_FLAG_DOOMED) == 0u;
    keep = keep && inst < NODE_CAPACITY
        && surfels[id].instance_generation == instance_generation.generation[inst];

    vec3 p = vec3(0.0);
    vec3 n = vec3(0.0, 1.0, 0.0);
    if (keep) {
        const mat4 model = instance_model(inst, surfels[id].bone);
        p = (model * vec4(surfels[id].bind_position, 1.0)).xyz;
        n = normalize(transpose(inverse(mat3(model))) * decompress_unit_vec(surfels[id].normal_bind));
        keep = distance(get_eye_position(), p) <= SURFEL_MAX_DISTANCE;
    }
    if (keep) {
        const bool pressure = uint(state[ST_FREE_AT_BEGIN]) < MAX_SURFELS / SURFEL_PRESSURE_DIVISOR;
        const uint limit = pressure ? SURFEL_PRESSURE_UNSEEN_FRAMES : SURFEL_UNSEEN_FRAMES;
        keep = gi_data.frame_index - surfels[id].last_seen <= limit;
    }

    if (keep) {
        surfels[id].position = p;
        surfels[id].normal = n;
        geo[id] = vec4(p, surfels[id].radius);
        nrm[id] = compress_unit_vec(n);
        surfel_push_alive(id);
    } else {
        surfels[id].flags = 0u;
        surfel_light[id] = vec4(0.0);
        light_rec[id] = empty_light_record();
        const uint slot = uint(atomicAdd(state[ST_FREE], 1));
        free_ids[slot] = id;
        atomicAdd(state[ST_EVICTED], 1);
    }
}

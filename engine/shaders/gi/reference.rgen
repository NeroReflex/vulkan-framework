// Ground truth for the indirect irradiance of the primary hit: a Lambertian
// path tracer with cosine sampling and next-event estimation of the sun,
// limited to gi_data.reference_bounces bounces, progressively averaged while
// the camera and the scene are still.
//
//   E_ind(x) = pi * L(h1),  L(h) = rho/pi * (E_dir(h) + E_ind(h))
//   => E_ind(x) ~= sum_k (prod_{j<k} rho_j) * rho_k * E_dir(h_k)
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable

#define RT_DESCRIPTOR_SET 0
#include "../rt_descriptor_set.glsl"

#define STATUS_DESCRIPTOR_SET 1
#include "../status.glsl"

#define GBUFFER_DESCRIPTOR_SET 2
#include "../gbuffer.glsl"

#define SURFEL_SET 3
#include "surfels.glsl"
#include "pixel.glsl"
#include "rt.glsl"

void main() {
    const ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    if (!in_render_area(px)) {
        return;
    }
    vec3 x, n, albedo;
    uint inst;
    if (!load_pixel(px, x, n, albedo, inst)) {
        imageStore(gi_images[IMG_EREF], px, vec4(0.0));
        return;
    }
    uint rng = rng_seed(uint(px.x) + uint(px.y) * gi_data.render_width, gi_data.frame_index, 0x0bad5eedu);

    vec3 estimate = vec3(0.0);
    for (uint s = 0u; s < REFERENCE_SPP; s++) {
        vec3 p = x;
        vec3 pn = n;
        vec3 throughput = vec3(1.0);
        for (uint bounce = 0u; bounce < gi_data.reference_bounces; bounce++) {
            const vec3 dir = sample_cosine(pn, rng_float(rng), rng_float(rng));
            if (!trace_closest(offset_origin(p, pn), dir)) {
                break;
            }
            const vec3 hp = payload.position;
            const vec3 hn = payload.normal;
            const vec3 rho = payload.albedo;
            estimate += throughput * rho * direct_irradiance(offset_origin(hp, hn), hn);
            throughput *= rho;
            p = hp;
            pn = hn;
        }
    }
    estimate /= float(REFERENCE_SPP);

    const vec4 old = imageLoad(gi_images[IMG_EREF], px);
    const float count = gi_data.still_frames == 0u ? 0.0 : old.a;
    imageStore(gi_images[IMG_EREF], px, vec4((old.rgb * count + estimate) / (count + 1.0), count + 1.0));
}

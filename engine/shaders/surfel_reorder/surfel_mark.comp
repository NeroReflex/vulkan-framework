#extension GL_EXT_debug_printf : enable

#include "../config.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define STATUS_DESCRIPTOR_SET 0
#include "../status.glsl"

#define SURFEL_NO_IMAGES 1
#define SURFEL_NO_DISCOVERED 1
#define SURFEL_NO_SCRATCH 1
#define SURFELS_DESCRIPTOR_SET 1
#include "../surfel.glsl"

// Keep in sync with surfel_keys.comp
uint surfel_level(float radius) {
    if (radius < 32.0) return 0u;
    if (radius < 64.0) return 1u;
    return 2u;
}

// Mark committed surfels that should leave the tree. Indices do not change.
void main() {
    const uint surfel_id = gl_GlobalInvocationID.x;
    if (surfel_id >= uint(high_water)) {
        return;
    }

    const uint flags = surfels[surfel_id].flags;
    if ((flags & SURFEL_FLAG_DEAD) != 0u) {
        return;
    }
    // Uninitialized or unpublished slots are not in the tree yet.
    if ((flags & SURFEL_FLAG_READY) == 0u) {
        return;
    }

    const vec2 clip_space = reconstructNearFarFromCamera();
    const vec3 eye_position = get_eye_position();
    const vec3 center = surfelPosition(surfel_id);

#if DELETE_NOT_CONTRIBUTING_SURFELS
    surfels[surfel_id].latest_contribution += 1u;
    if (surfels[surfel_id].latest_contribution >= DELETE_NOT_CONTRIBUTING_SURFELS) {
        atomicOr(surfels[surfel_id].flags, SURFEL_FLAG_DEAD);
        atomicStore(index_topology_dirty, 1u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
        return;
    }
#endif

    const float ideal_radius = radius_from_camera_distance(eye_position, clip_space, center);
    const float stored_radius = surfels[surfel_id].radius;
    if (abs(ideal_radius - stored_radius) > DELETE_ON_RADIUS_DIFFERENCE) {
        // Step toward ideal radius without snapping to far-plane size in one frame.
        float new_radius = stored_radius;
        if (ideal_radius > stored_radius) {
            new_radius = min(ideal_radius, stored_radius + DELETE_ON_RADIUS_DIFFERENCE);
        } else {
            new_radius = max(ideal_radius, stored_radius - DELETE_ON_RADIUS_DIFFERENCE);
        }
        new_radius = clamp(new_radius, MIN_SURFEL_RADIUS, MAX_SURFEL_RADIUS);
        const uint old_level = surfel_level(stored_radius);
        const uint new_level = surfel_level(new_radius);
        surfels[surfel_id].radius = new_radius;
        // Rebuild the hash only when the bucket level changes — not on every radius tick.
        if (old_level != new_level) {
            atomicStore(index_topology_dirty, 1u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
        }
    }

    if (is_out_of_range(eye_position, center, clip_space)) {
        atomicOr(surfels[surfel_id].flags, SURFEL_FLAG_DEAD);
        atomicStore(index_topology_dirty, 1u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
    }
}

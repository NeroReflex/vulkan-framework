// Frozen copy of the old per-surfel counting sort. Test-only.
// The frame graph does not dispatch this shader.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint count;
    float eye_x;
    float eye_y;
    float eye_z;
    float clip_near;
    float clip_far;
} params;

struct Point {
    float x;
    float y;
    float z;
};

layout(std430, set = 0, binding = 0) readonly buffer PointsIn {
    Point points[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OrderOut {
    uint order[];
};

uint expandBits(uint v) {
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint morton3D(vec3 v) {
    const float x = min(max(v.x * 1024.0, 0.0), 1023.0);
    const float y = min(max(v.y * 1024.0, 0.0), 1023.0);
    const float z = min(max(v.z * 1024.0, 0.0), 1023.0);
    const uint xx = expandBits(uint(x));
    const uint yy = expandBits(uint(y));
    const uint zz = expandBits(uint(z));
    return xx * 4u + yy * 2u + zz;
}

uint morton_code(vec3 center) {
    const float range = abs(params.clip_far) - abs(params.clip_near);
    const vec3 eye = vec3(params.eye_x, params.eye_y, params.eye_z);
    const vec3 min_allowed = eye - vec3(range);
    const vec3 max_allowed = eye + vec3(range);
    if (any(lessThan(center, min_allowed)) || any(greaterThan(center, max_allowed))) {
        return 0xFFFFFFFFu;
    }
    const vec3 converted = (center - min_allowed) / (max_allowed - min_allowed);
    return morton3D(converted);
}

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= params.count) {
        return;
    }

    const uint key = morton_code(vec3(points[index].x, points[index].y, points[index].z));
    uint rank = 0u;
    for (uint other = 0u; other < params.count; ++other) {
        const uint other_key = morton_code(vec3(points[other].x, points[other].y, points[other].z));
        if (other_key < key || (other_key == key && other < index)) {
            rank += 1u;
        }
    }
    order[rank] = index;
}

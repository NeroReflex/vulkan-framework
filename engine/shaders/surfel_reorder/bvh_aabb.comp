#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics : require

#include "../config.glsl"
#include "../aabb.glsl"
#include "build_layout.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define SURFEL_NO_IMAGES 1
#define SURFEL_NO_DISCOVERED 1
#define SURFEL_NO_SCRATCH 1
#define SURFELS_DESCRIPTOR_SET 0
#include "../surfel.glsl"

layout (set = SURFELS_DESCRIPTOR_SET, binding = 7, std430) buffer surfel_build_scratch {
    uint build_words[];
};

AABB leaf_box(uint key) {
    const uint surfel_id = build_words[OFF_KEYS_A + key * KEY_STRIDE + 1u];
    return surfelAABB(surfel_id);
}

AABB stored_union(uint node) {
    const vec3 bmin = min(
        vec3(tree[node].lmin_x, tree[node].lmin_y, tree[node].lmin_z),
        vec3(tree[node].rmin_x, tree[node].rmin_y, tree[node].rmin_z)
    );
    const vec3 bmax = max(
        vec3(tree[node].lmax_x, tree[node].lmax_y, tree[node].lmax_z),
        vec3(tree[node].rmax_x, tree[node].rmax_y, tree[node].rmax_z)
    );
    return compatAABB(bmin, bmax);
}

AABB child_box(uint child) {
    if ((child & NODE_IS_LEAF_FLAG) != 0u) {
        return leaf_box(child & ~NODE_IS_LEAF_FLAG);
    }
    return stored_union(child);
}

void store_children(uint node, AABB left_box, AABB right_box) {
    tree[node].lmin_x = left_box.vMin.x;
    tree[node].lmin_y = left_box.vMin.y;
    tree[node].lmin_z = left_box.vMin.z;
    tree[node].lmax_x = left_box.vMax.x;
    tree[node].lmax_y = left_box.vMax.y;
    tree[node].lmax_z = left_box.vMax.z;
    tree[node].rmin_x = right_box.vMin.x;
    tree[node].rmin_y = right_box.vMin.y;
    tree[node].rmin_z = right_box.vMin.z;
    tree[node].rmax_x = right_box.vMax.x;
    tree[node].rmax_y = right_box.vMax.y;
    tree[node].rmax_z = right_box.vMax.z;
}

void main() {
    const uint n = build_words[HDR_KEY_COUNT];
    const uint leaf = gl_GlobalInvocationID.x;
    if (n == 0u || leaf >= n) {
        return;
    }

    if (n == 1u) {
        if (leaf == 0u) {
            const AABB box = leaf_box(0u);
            store_children(0u, box, box);
            if (build_words[HDR_BUILD_ACTIVE] != 0u) {
                atomicStore(index_topology_dirty, 0u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
            }
        }
        return;
    }

    uint node = build_words[OFF_LEAF_PARENT + leaf];
    for (uint hop = 0u; hop < 96u; ++hop) {
        const uint prev = atomicAdd(
            tree[node].flags,
            1u,
            gl_ScopeDevice,
            gl_StorageSemanticsBuffer,
            gl_SemanticsAcquireRelease
        );
        if (prev != 1u) {
            return;
        }

        store_children(node, child_box(tree[node].left), child_box(tree[node].right));

        if (node == 0u) {
            if (build_words[HDR_BUILD_ACTIVE] != 0u) {
                atomicStore(index_topology_dirty, 0u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
            }
            return;
        }
        const uint parent = tree[node].parent;
        if (parent == node) {
            return;
        }
        node = parent;
    }
}
